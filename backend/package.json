{
  "name": "vessel-tracking-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import dotenv/config src/index.js",
    "start": "node --import dotenv/config src/index.js",
    "test": "node --test test/*.test.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "auth:migrate:dry-run": "node scripts/migrate-password-hashes.mjs",
    "auth:migrate:apply": "node scripts/migrate-password-hashes.mjs --apply"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "node-cron": "^4.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.3.4",
    "prisma": "^5.9.1"
  }
}
