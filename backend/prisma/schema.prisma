generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vessel {
  id           Int        @id @default(autoincrement())
  mmsi         String     @unique
  name         String?
  alias        String?
  companyType  String     @default("자사간사")
  color        String     @default("#3b82f6")
  imo          String?
  callsign     String?
  countryIso   String?
  countryName  String?
  vesselType   String?
  typeSpecific String?
  grossTonnage Int?
  deadweight   Int?
  length       Float?
  breadth      Float?
  yearBuilt    String?
  homePort     String?
  speedAvg     Float?
  speedMax     Float?
  infoFetched  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  positions    Position[]
}

model Position {
  id           Int       @id @default(autoincrement())
  vesselId     Int
  vessel       Vessel    @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  lat          Float
  lon          Float
  cog          Float?
  sog          Float?
  heading      Int?
  navStatus    String?
  destination  String?
  eta          DateTime?
  timestamp    DateTime  @default(now())
  suspicious   Boolean   @default(false)   // 스푸핑 의심 플래그
  impliedSpeed Float?                      // 계산된 신호 속도 (knots)
  spoofReason  String?                     // 의심 이유 메시지

  @@unique([vesselId, timestamp])
  @@index([vesselId, timestamp(sort: Desc)])
}

model Incident {
  id           Int      @id @default(autoincrement())
  date         DateTime
  vesselName   String
  incidentType String
  severity     String
  lat          Float
  lon          Float
  cargo        String?
  crew         String?
  description  String?
  link         String?
  source       String?
  createdAt    DateTime @default(now())
}

model SharedView {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  label     String
  vesselIds String   // JSON array of vessel IDs e.g. "[3,4,5]"
  createdAt DateTime @default(now())
  expiresAt DateTime?
}
